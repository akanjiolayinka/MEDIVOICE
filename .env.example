# Backend (copy to backend/.env)

# Sahara CodeSwitch API — required for real speech transcription (Phase 3).
# Without this, /api/voice/process returns 503 service_not_configured
# instead of a fake transcript.
SAHARA_API_KEY=
SAHARA_API_URL=

# Not used yet — declared here so the full set of variables the finished
# product needs is visible up front.
YARNGPT_API_KEY=      # Phase 7 — voice synthesis
LLM_API_KEY=          # Phase 4 — conversation agent
FACILITY_API_KEY=     # Phase 9 — healthcare facility search
DATABASE_URL=         # Phase 5+ — conversation persistence

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
